# AI-FORGE — native local development (Windows / macOS / Linux)
# Copy to .env:  copy .env.example .env
#
# Required locally: PostgreSQL
# Optional locally: Redis, RabbitMQ, Celery worker
# Docker Compose hostnames (postgres/redis/rabbitmq) are for containers only —
# do not use them in this file for native development.

APP_NAME=AI_Forge
APP_VERSION=1.0.0
APP_ENV=local
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_CONFIG_PATH=configs/logging.json

# Vite dev server (npm run dev) uses port 5173. Same-origin /api proxy is primary;
# these origins cover direct browser→API calls during local UI work.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

JWT_SECRET=replace-in-local-environment
JWT_ALGORITHM=HS256

# Default administrator is seeded automatically when username "admin" is absent:
#   username=admin  password=admin  (Argon2id hash in PostgreSQL; never plaintext)
# Seeding is idempotent and never overwrites an existing admin password.
# Optional legacy override (unused when admin already exists):
# AUTH_BOOTSTRAP_USERNAME=admin
# AUTH_BOOTSTRAP_PASSWORD=replace-with-strong-password

# Native PostgreSQL (required). Create role/db to match, then migrate.
DATABASE_URL=postgresql+psycopg://ai_forge:ai_forge@localhost:5432/ai_forge
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_HEALTH_TIMEOUT_SECONDS=2

STORAGE_ROOT=data
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=50
UPLOAD_CHUNK_SIZE_BYTES=1048576
SUPPORTED_EXTENSIONS={"image":["jpg","jpeg","png","webp","tif","tiff"],"document":["pdf","docx"],"video":["mp4","mov","avi","mkv","webm"],"audio":["wav","mp3","m4a","aac","flac"]}
SUPPORTED_MIME_TYPES={"image":["image/jpeg","image/png","image/webp","image/tiff"],"document":["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document"],"video":["video/mp4","video/quicktime","video/x-msvideo","video/x-matroska","video/webm"],"audio":["audio/wav","audio/x-wav","audio/mpeg","audio/mp4","audio/aac","audio/flac"]}
OCR_ENABLED=false
OCR_COMMAND=tesseract
FFPROBE_COMMAND=ffprobe
FFMPEG_COMMAND=ffmpeg
EXTRACTION_MAX_PAGES=1000
EXTRACTION_MAX_TEXT_CHARS=1000000
EXTRACTION_MAX_ITEMS=10000
MEDIA_SAMPLE_INTERVAL_SECONDS=5
MEDIA_MAX_FRAMES=120

# Single-node jobs via FastAPI BackgroundTasks (no Celery/RabbitMQ required).
JOB_QUEUE_MODE=local

# Redis is optional for local API work. Rate limits fall back to in-memory when
# Redis is down; set false to skip Redis rate-limit attempts entirely.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# Used only when JOB_QUEUE_MODE=celery (or redis queue mode). Safe to leave as
# localhost placeholders while JOB_QUEUE_MODE=local.
CELERY_BROKER_URL=amqp://ai_forge:ai_forge@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Compose bootstrap vars (unused by native uvicorn; kept for docker compose parity)
POSTGRES_DB=ai_forge
POSTGRES_USER=ai_forge
POSTGRES_PASSWORD=ai_forge
RABBITMQ_DEFAULT_USER=ai_forge
RABBITMQ_DEFAULT_PASS=ai_forge
