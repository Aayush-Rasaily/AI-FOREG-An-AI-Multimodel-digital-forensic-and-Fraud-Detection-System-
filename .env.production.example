APP_NAME=AI_Forge
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_CONFIG_PATH=configs/logging.json
CORS_ORIGINS=["https://ai-forge.example.com"]

# Required secrets — replace before deploy
JWT_SECRET=replace-with-long-random-secret
JWT_ALGORITHM=HS256
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=replace-bootstrap-password

DATABASE_URL=postgresql+psycopg://ai_forge:change-me@postgres:5432/ai_forge
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_HEALTH_TIMEOUT_SECONDS=2

STORAGE_ROOT=/app/data
TEMP_STORAGE_PATH=/app/data/tmp
AI_MODEL_ROOT=/app/models
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=50

REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50
CELERY_BROKER_URL=amqp://ai_forge:change-me@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

POSTGRES_DB=ai_forge
POSTGRES_USER=ai_forge
POSTGRES_PASSWORD=change-me
RABBITMQ_DEFAULT_USER=ai_forge
RABBITMQ_DEFAULT_PASS=change-me

API_HOST_BIND=127.0.0.1
API_PORT=8000
FRONTEND_HOST_BIND=127.0.0.1
FRONTEND_PORT=8080
VITE_API_BASE_URL=/api/v1
CELERY_CONCURRENCY=2
